# --- KASAI ENVIRONMENT VARIABLES ---

# Database (PostgreSQL required for production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://kasai:kasai_secret@localhost:5432/kasai_db?schema=public"

# AI Configuration (Core Feature: Voice-to-Journal)
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY"
VOICE_API_URL="http://43.133.142.68:5000/transcribe"
AI_PROVIDER="openai" # Switch to 'alibaba' if needed

# Alibaba AI Fallback (Optional)
# DASHSCOPE_API_KEY="sk-YOUR_ALIBABA_KEY"
# ALIBABA_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# Application Settings
DEMO_MODE="false" # Set true strictly during Hackathon Demo Pitch to bypass some security locks if necessary
DEMO_BUSINESS_ID="biz_demo_001" # Default user/tenant ID for the MVP

# Notes:
# Coolify deployment: Ensure DATABASE_URL is set in the Coolify UI using the internal network URL provided by Coolify's Postgres service.
